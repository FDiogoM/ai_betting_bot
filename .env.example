# Copy this file to .env and fill in the key. .env is gitignored — never commit it.
#
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# Get a key at https://dashboard.api-football.com (the free plan allows 100
# requests/day, which the cache stretches a long way).
API_FOOTBALL_KEY=

# --- Everything below is optional; the defaults work on any machine. ---

# Where the prediction ledger is written. Defaults to <repo>/ledger.
# MCP_LEDGER_DIR=

# HTTP timeout for provider calls, in milliseconds. Defaults to 10000.
# MCP_HTTP_TIMEOUT_MS=

# Ceiling on live requests a single tool call may spend. See quota.js.
# MCP_MAX_REQUESTS_PER_CALL=

# The bookmaker(s) you hold an account with, comma separated. PRICES are taken
# only from these, because a price you cannot reach is not an edge; the market
# CONSENSUS still comes from every book quoting the market, because that is the
# best estimate of what the market thinks. Unset means unrestricted, which is
# only correct if you really do shop across every book.
# MCP_BOOKMAKERS=Betano

# Pace limit, requests per minute. The provider allows 300 and this stays under
# it, because our window rolls and theirs does not. Defaults to 240.
# MCP_MAX_REQUESTS_PER_MINUTE=

# The server exits after this long without a tool call, so processes do not
# accumulate serving stale code. An MCP client respawns it on demand. Defaults
# to 1800000 (30 minutes); 0 disables it.
# MCP_IDLE_TIMEOUT_MS=

# Where cached provider responses go. Defaults to mcp-server/.cache.
# MCP_CACHE_DIR=

# --- Telegram delivery (optional; the bulletin still publishes without it) ---
#
# Create a bot by messaging @BotFather on Telegram, then paste the token it
# gives you. TELEGRAM_CHAT_ID is your own chat: message the bot once, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read result[0].message.chat.id
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
